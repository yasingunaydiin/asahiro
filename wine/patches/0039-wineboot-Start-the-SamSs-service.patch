From: NelloKudo <marshnelloosu@gmail.com>
Date: Thu, 15 Oct 2026 18:31:26 +0200
Subject: [PATCH 39/42] wineboot: Start the SamSs service.

Should be dropped with Proton 12 rebase.

GE: start the service after the other boot-time registry setup so the
hunk does not overlap wineboot-create-sqm-machine-id.patch.

[applied with fuzz to CrossOver 26.1]

From GE-Proton, patches/game-patches/ace-wineboot-start-samss-service.patch.
---
 programs/wineboot/wineboot.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index 5e702a5c..955dde58 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1516,6 +1516,27 @@ static HWND show_wait_window(void)
     return hwnd;
 }
 
+static void start_samss_service(void)
+{
+    SC_HANDLE scm, service;
+
+    if (!(scm = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT )))
+    {
+        WINE_ERR( "Failed to open service manager: error %lu\n", GetLastError() );
+        return;
+    }
+    if (!(service = OpenServiceW( scm, L"SamSs", SERVICE_START )))
+    {
+        WINE_WARN( "Failed to open SamSs service: error %lu\n", GetLastError() );
+        CloseServiceHandle( scm );
+        return;
+    }
+    if (!StartServiceW( service, 0, NULL ) && GetLastError() != ERROR_SERVICE_ALREADY_RUNNING)
+        WINE_ERR( "Failed to start SamSs service: error %lu\n", GetLastError() );
+    CloseServiceHandle( service );
+    CloseServiceHandle( scm );
+}
+
 static HANDLE start_rundll32( const WCHAR *inf_path, const WCHAR *install, WORD machine )
 {
     WCHAR app[MAX_PATH + ARRAY_SIZE(L"\\rundll32.exe" )];
@@ -1967,6 +1988,7 @@ int __cdecl main( int argc, char *argv[] )
     create_volatile_environment_registry_key();
     create_known_dlls();
     initialize_internet();
+    if (init || (kill && !restart)) start_samss_service();
 
     ProcessRunKeys( HKEY_LOCAL_MACHINE, L"RunOnce", TRUE, TRUE );
 
