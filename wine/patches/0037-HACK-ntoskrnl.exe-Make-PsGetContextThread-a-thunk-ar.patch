From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Thu, 15 Oct 2026 21:26:14 +0200
Subject: [PATCH 37/42] HACK: ntoskrnl.exe: Make PsGetContextThread a thunk
 around a helper.

[CrossOver 26.1 has dwproton's two-argument PsGetContextThread, so it was renamed to get_context_thread with a mode parameter by hand]

From GE-Proton, patches/game-patches/ace-ntoskrnl-psgetcontextthread-thunk.patch.
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 71171a3a..d26305ef 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2859,10 +2859,7 @@ HANDLE WINAPI PsGetThreadProcessId( PETHREAD thread )
     return thread->kthread.id.UniqueProcess;
 }
 
-/*********************************************************************
- *           PsGetContextThread    (NTOSKRNL.@)
- */
-NTSTATUS WINAPI PsGetContextThread(PETHREAD thread, CONTEXT *context)
+NTSTATUS WINAPI get_context_thread( PETHREAD thread, CONTEXT *context, KPROCESSOR_MODE mode )
 {
     NTSTATUS status;
     HANDLE handle, id = PsGetThreadId(thread);
@@ -2875,6 +2872,26 @@ NTSTATUS WINAPI PsGetContextThread(PETHREAD thread, CONTEXT *context)
     return status;
 }
 
+/*********************************************************************
+ *           PsGetContextThread    (NTOSKRNL.@)
+ */
+#if defined(__x86_64__) && !defined(__arm64ec__)
+__ASM_GLOBAL_FUNC( PsGetContextThread,
+                   "subq $0x28,%rsp\n\t"
+                   __ASM_SEH(".seh_stackalloc 0x28\n\t")
+                   __ASM_SEH(".seh_endprologue\n\t")
+                   __ASM_CFI(".cfi_adjust_cfa_offset 0x28\n\t")
+                   "call " __ASM_NAME("get_context_thread") "\n\t"
+                   "addq $0x28,%rsp\n\t"
+                   __ASM_CFI(".cfi_adjust_cfa_offset -0x28\n\t")
+                   "ret" )
+#else
+NTSTATUS WINAPI PsGetContextThread( PETHREAD thread, CONTEXT *context, KPROCESSOR_MODE mode )
+{
+    return get_context_thread( thread, context, mode );
+}
+#endif
+
 /***********************************************************************
  *           KeInsertQueue   (NTOSKRNL.EXE.@)
  */
