From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yasin Gunaydin <y.gunaydinmail@gmail.com>
Date: Sat, 31 Oct 2026 15:04:59 +0100
Subject: [PATCH 42/42] ntoskrnl: Add no-op stubs for the Inbv boot display
 functions.

---
 dlls/ntoskrnl.exe/ntoskrnl.c        | 62 +++++++++++++++++++++++++++++
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec | 22 +++++-----
 2 files changed, 73 insertions(+), 11 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 71f3f672..82ce786f 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -5118,6 +5118,68 @@ NTSTATUS WINAPI KdDisableDebugger(void)
     return STATUS_DEBUGGER_INACTIVE;
 }
 
+/* boot video display. there is no boot screen to draw on, so these do nothing */
+
+void WINAPI InbvAcquireDisplayOwnership(void)
+{
+    FIXME(": stub.\n");
+}
+
+BOOLEAN WINAPI InbvCheckDisplayOwnership(void)
+{
+    FIXME(": stub.\n");
+    return TRUE;
+}
+
+BOOLEAN WINAPI InbvDisplayString(char *string)
+{
+    FIXME("%s: stub.\n", debugstr_a(string));
+    return TRUE;
+}
+
+BOOLEAN WINAPI InbvEnableDisplayString(BOOLEAN enable)
+{
+    FIXME("%u: stub.\n", enable);
+    return TRUE;
+}
+
+void WINAPI InbvInstallDisplayStringFilter(void *filter)
+{
+    FIXME("%p: stub.\n", filter);
+}
+
+BOOLEAN WINAPI InbvIsBootDriverInstalled(void)
+{
+    FIXME(": stub.\n");
+    return FALSE;
+}
+
+void WINAPI InbvNotifyDisplayOwnershipLost(void *callback)
+{
+    FIXME("%p: stub.\n", callback);
+}
+
+BOOLEAN WINAPI InbvResetDisplay(void)
+{
+    FIXME(": stub.\n");
+    return TRUE;
+}
+
+void WINAPI InbvSetScrollRegion(ULONG left, ULONG top, ULONG right, ULONG bottom)
+{
+    FIXME("%lu %lu %lu %lu: stub.\n", left, top, right, bottom);
+}
+
+void WINAPI InbvSetTextColor(ULONG color)
+{
+    FIXME("%lu: stub.\n", color);
+}
+
+void WINAPI InbvSolidColorFill(ULONG left, ULONG top, ULONG right, ULONG bottom, ULONG color)
+{
+    FIXME("%lu %lu %lu %lu %lu: stub.\n", left, top, right, bottom, color);
+}
+
 NTSTATUS WINAPI KdEnableDebugger(void)
 {
     FIXME(": stub.\n");
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 2f5ec94a..15cf2d94 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -314,18 +314,18 @@
 @ stub HalDispatchTable
 @ stub HalPrivateDispatchTable
 @ stub HeadlessDispatch
-@ stub InbvAcquireDisplayOwnership
-@ stub InbvCheckDisplayOwnership
-@ stub InbvDisplayString
+@ stdcall InbvAcquireDisplayOwnership()
+@ stdcall InbvCheckDisplayOwnership()
+@ stdcall InbvDisplayString(str)
 @ stub InbvEnableBootDriver
-@ stub InbvEnableDisplayString
-@ stub InbvInstallDisplayStringFilter
-@ stub InbvIsBootDriverInstalled
-@ stub InbvNotifyDisplayOwnershipLost
-@ stub InbvResetDisplay
-@ stub InbvSetScrollRegion
-@ stub InbvSetTextColor
-@ stub InbvSolidColorFill
+@ stdcall InbvEnableDisplayString(long)
+@ stdcall InbvInstallDisplayStringFilter(ptr)
+@ stdcall InbvIsBootDriverInstalled()
+@ stdcall InbvNotifyDisplayOwnershipLost(ptr)
+@ stdcall InbvResetDisplay()
+@ stdcall InbvSetScrollRegion(long long long long)
+@ stdcall InbvSetTextColor(long)
+@ stdcall InbvSolidColorFill(long long long long long)
 @ extern InitSafeBootMode
 @ stdcall IoAcquireCancelSpinLock(ptr)
 @ stdcall IoAcquireRemoveLockEx(ptr ptr str long long)
