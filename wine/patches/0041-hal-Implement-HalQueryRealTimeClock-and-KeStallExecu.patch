Subject: [PATCH 41/42] hal: Implement HalQueryRealTimeClock and
 KeStallExecutionProcessor, add a HalSetBusDataByOffset stub.

---
 dlls/hal/hal.c    | 34 ++++++++++++++++++++++++++++++++++
 dlls/hal/hal.spec |  6 +++---
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/dlls/hal/hal.c b/dlls/hal/hal.c
index e339f21a..2b3eebd6 100644
--- a/dlls/hal/hal.c
+++ b/dlls/hal/hal.c
@@ -179,6 +179,40 @@ ULONG WINAPI HalGetBusDataByOffset(BUS_DATA_TYPE BusDataType, ULONG BusNumber, U
     return 0;
 }
 
+ULONG WINAPI HalSetBusDataByOffset(BUS_DATA_TYPE BusDataType, ULONG BusNumber, ULONG SlotNumber, PVOID Buffer, ULONG Offset, ULONG Length)
+{
+    FIXME("(%u %lu %lu %p %lu %lu) stub!\n", BusDataType, BusNumber, SlotNumber, Buffer, Offset, Length);
+    /* Claim that there is no such bus */
+    return 0;
+}
+
+/* the cmos clock holds local time on windows */
+BOOLEAN WINAPI HalQueryRealTimeClock(TIME_FIELDS *time)
+{
+    LARGE_INTEGER now, local;
+
+    TRACE("(%p)\n", time);
+
+    KeQuerySystemTime(&now);
+    RtlSystemTimeToLocalTime(&now, &local);
+    RtlTimeToTimeFields(&local, time);
+    return TRUE;
+}
+
+void WINAPI KeStallExecutionProcessor(ULONG microseconds)
+{
+    LARGE_INTEGER start, now, frequency;
+
+    TRACE("(%lu)\n", microseconds);
+
+    NtQueryPerformanceCounter(&start, &frequency);
+    do
+    {
+        YieldProcessor();
+        NtQueryPerformanceCounter(&now, NULL);
+    } while ((now.QuadPart - start.QuadPart) * 1000000 / frequency.QuadPart < microseconds);
+}
+
